{
  "name": "@cjcut/editor",
  "private": false,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:plugin": "tsc -p tsconfig.plugin.json && node -e \"require('node:fs').copyFileSync('src/styles.css','dist-plugin/styles.css')\"",
    "prepare": "npm run build:plugin"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "lucide-react": "^0.544.0",
    "vite": "^7.1.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2"
  },
  "main": "./dist-plugin/plugin.js",
  "module": "./dist-plugin/plugin.js",
  "types": "./dist-plugin/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist-plugin/plugin.d.ts",
      "import": "./dist-plugin/plugin.js"
    },
    "./styles.css": "./dist-plugin/styles.css"
  }
}
